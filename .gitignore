/docs/diagrams/*.html
/docs/diagrams/*.visual-check.*

# 测试覆盖率
/coverage

# 环境变量 / 密钥 —— 绝不提交任何 API key（.example 模板例外，可提交）
.env
.env.*
!.env.example
# Wrangler 本地开发变量：存真实 API key，绝不入库
.dev.vars
.dev.vars.*
!.dev.vars.example

# 系统 / 编辑器杂项
.DS_Store
Thumbs.db
*.pem

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

