{
  "name": "flowlens",
  "version": "0.1.0",
  "private": true,
  "description": "FlowLens — a lightweight AI workflow analysis tool",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "smoke": "tsx scripts/smoke.ts",
    "snapshot": "tsx scripts/render-snapshot.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "dev:full": "next build && npx wrangler pages dev out"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
